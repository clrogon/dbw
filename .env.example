# Supabase (public/anon values — safe to commit as example)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# REQUIRED for builds, dev, and runtime.
# A hardcoded anon JWT is intentionally NOT shipped in src/config/supabasePublic.ts;
# instead, the build fails loudly when this key is unset so a Supabase key rotation
# on the dashboard cannot silently leave the bundle shipping a stale key. Set this
# on Vercel (Production + Preview) and in your local .env.
# See SECURITY.md for the rotation procedure.

# Optional: WhatsApp number for booking / floating CTA (digits only, with country code; no + or spaces)
# Invalid values are ignored and fall back to 244922569283
# VITE_WHATSAPP_NUMBER="244922569283"
