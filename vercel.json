{
  "rewrites": [
    { "source": "/sobre", "destination": "/sobre.html" },
    { "source": "/servicos", "destination": "/servicos.html" },
    { "source": "/servicos/actividades-aquaticas", "destination": "/servicos/actividades-aquaticas.html" },
    { "source": "/servicos/treinos-personalizados", "destination": "/servicos/treinos-personalizados.html" },
    { "source": "/servicos/ginastica-laboral", "destination": "/servicos/ginastica-laboral.html" },
    { "source": "/servicos/aulas-em-grupo", "destination": "/servicos/aulas-em-grupo.html" },
    { "source": "/instrutores", "destination": "/instrutores.html" },
    { "source": "/galeria", "destination": "/galeria.html" },
    { "source": "/reservar", "destination": "/reservar.html" },
    { "source": "/contacto", "destination": "/contacto.html" },
    { "source": "/instalar", "destination": "/instalar.html" },
    { "source": "/politica-de-privacidade", "destination": "/politica-de-privacidade.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://*.supabase.co; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https://images.unsplash.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src 'self' https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://wa.me; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
